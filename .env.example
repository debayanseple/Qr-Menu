# Copy to .env and adjust. Never commit real secrets.
# Postgres (used by docker-compose.yml and apps/api)
POSTGRES_USER=qr_app
POSTGRES_PASSWORD=qr_dev_password
POSTGRES_DB=qr_ordering
POSTGRES_PORT=5432
DATABASE_URL=postgresql://qr_app:qr_dev_password@localhost:5432/qr_ordering

# API
API_PORT=4000
JWT_SECRET=change-me-in-dev
CORS_ORIGIN=http://localhost:5173

# Web
VITE_API_URL=http://localhost:4000
